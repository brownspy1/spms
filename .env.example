# SPMS Environment Variables Configuration

# Security & JWT Secrets (Change in Production!)
SECRET_KEY=spms-production-jwt-secret-key-replace-with-cryptographic-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (Default: SQLite; On Railway: PostgreSQL URL)
DATABASE_URL=sqlite:///./spms.db
# DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Prescription Retention Compliance (days)
PRESCRIPTION_RETENTION_DAYS=90

# Optional Clinical AI Integration Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port (auto-assigned on Railway)
PORT=8000
